<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/layout_distance_medium">

    <ImageView
        android:id="@+id/image_view_view_holder_image_favorite_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/images"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/image_view_view_holder_image_favorite_star"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/layout_distance_small"
        android:layout_marginEnd="@dimen/layout_distance_small"
        android:contentDescription="@string/favorite_images"
        android:src="@drawable/ic_star_empty" />

    <TextView
        android:id="@+id/text_view_view_holder_image_favorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorWhiteTransparent"
        android:paddingStart="@dimen/layout_distance_small"
        android:paddingEnd="0dp"
        android:textColor="@color/colorBlack" />
</RelativeLayout>